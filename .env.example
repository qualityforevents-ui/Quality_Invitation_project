# Firebase. One project holds the database and the operator login.
# Service account: Firebase console, Project settings, Service accounts, Generate new
# private key. The three values below come out of that JSON file.
FIREBASE_PROJECT_ID="qlty-invitations"
FIREBASE_CLIENT_EMAIL=""
# Keep the surrounding quotes. The key contains newlines, which travel as literal \n.
FIREBASE_PRIVATE_KEY=""
# Web API key: Firebase console, Project settings, General. Used only to check the
# operator's password at sign in; it grants nothing on its own.
FIREBASE_WEB_API_KEY=""

# Copy to .env and fill in. See SETUP.md for where each value comes from.


# Public site origin, no trailing slash. Used to build shareable links.
NEXT_PUBLIC_SITE_URL="https://qlty.events"

# The operator WhatsApp number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="201010014346"

# InstaPay recipient shown on the payment screen. Both are copied by customers,
# so they must be exactly right.
# Payment is settled on WhatsApp, so none of the four values below is read by the app
# any more. They are kept because the code that used them is one commit away, and the
# InstaPay address is still the destination a human quotes in that conversation.
NEXT_PUBLIC_INSTAPAY_ADDRESS="qlty@instapay"
NEXT_PUBLIC_INSTAPAY_NAME="QLTY EVENTS"

# What the two pay buttons open. Neither app publishes a documented link that arrives
# with the recipient and amount already filled in, so find what actually works on a real
# phone and paste it here. The defaults just open the app, which is why every pay button
# also copies the recipient to the clipboard.
# The payment link from the InstaPay app, e.g. https://ipn.eg/S/<handle>/instapay/<code>.
# A bare "instapay://" is not a link: it opens the app on its own home screen with
# no recipient and no amount, which is what a customer reads as the button not working.
NEXT_PUBLIC_INSTAPAY_LINK=""
# Leave the number blank to hide the Vodafone Cash button entirely. A payment method
# that is switched on but not configured sends customers into an app with nowhere to
# send the money.
NEXT_PUBLIC_VODAFONE_CASH_NUMBER=""
NEXT_PUBLIC_VODAFONE_CASH_LINK="tel:*9%23"

#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ImageKit. Not used until stage 9, safe to leave blank for now.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""

