# Copy to .env and fill in. See SETUP.md for where each value comes from.

# Supabase Postgres, Frankfurt region.
# DATABASE_URL is the Supavisor TRANSACTION pooler on port 6543. Runtime queries use this.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL is the direct connection on port 5432. Migrations only, never runtime.
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Public site origin, no trailing slash. Used to build shareable links.
NEXT_PUBLIC_SITE_URL="https://qlty.events"

# The operator WhatsApp number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="201010014346"

# InstaPay recipient shown on the payment screen. Both are copied by customers,
# so they must be exactly right.
NEXT_PUBLIC_INSTAPAY_ADDRESS="qlty@instapay"
NEXT_PUBLIC_INSTAPAY_NAME="QLTY EVENTS"

# Secret shared with the Vercel cron scheduler. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET="replace-me"

# ImageKit. Not used until stage 9, safe to leave blank for now.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""

# Supabase Auth for the single operator account. Not used until stage 7.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
