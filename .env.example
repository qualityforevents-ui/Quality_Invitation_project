# Firebase. One project holds the database and the operator login.
# Service account: Firebase console, Project settings, Service accounts, Generate new
# private key. The three values below come out of that JSON file.
FIREBASE_PROJECT_ID="qlty-invitations"
FIREBASE_CLIENT_EMAIL=""
# Keep the surrounding quotes. The key contains newlines, which travel as literal \n.
FIREBASE_PRIVATE_KEY=""
# Web API key: Firebase console, Project settings, General. Used only to check the
# operator's password at sign in; it grants nothing on its own.
FIREBASE_WEB_API_KEY=""

# Copy to .env and fill in. See SETUP.md for where each value comes from.

# Public site origin, no trailing slash. Used to build shareable links.
NEXT_PUBLIC_SITE_URL="https://qlty.events"

# The operator WhatsApp number in international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER="201010014346"

NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=""
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""

# ---------------------------------------------------------------- Meta / Facebook
# The pixel, and its server side twin. Both halves send the same events; Meta pairs
# them by event id and counts one conversion. See src/lib/meta/.

# Events Manager, Data sources, your pixel. The long number in the title bar. Public by
# nature: it is in the page source of every site that has one.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token. Events Manager, your pixel, Settings, Conversions API,
# Generate access token. NOT prefixed NEXT_PUBLIC_ and it must never be — anything with
# that prefix is compiled into the JavaScript every visitor downloads, and whoever holds
# this token can write events into the ad account.
META_CAPI_ACCESS_TOKEN=

# Optional. Only set when the pixel id above is not the dataset receiving server events,
# which is unusual. Leave unset and the pixel id is used for both.
META_PIXEL_ID=

# Optional, and temporary. Events Manager, your pixel, Test events — the tab shows a
# code like TEST12345. Set it to watch events arrive live while wiring this up, then
# REMOVE IT. Left set in production, every conversion goes to the test tab, the live
# dataset receives nothing, and every campaign optimises on an empty pixel.
META_TEST_EVENT_CODE=

# ------------------------------------------------------------------- Photo booth
# Optional. A separate WhatsApp number for booth enquiries, in international form
# without a plus, e.g. 201010014346. Almost certainly leave this unset: it is one
# business with one phone, and the variable exists so booth enquiries can be split off
# later without a code change. Unset, booth messages go to NEXT_PUBLIC_WHATSAPP_NUMBER.
NEXT_PUBLIC_WHATSAPP_BOOTH_NUMBER=

# Optional. The Instagram handle the home page's strip and footer link to, without the
# @. Defaults to qlty.events.
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# ------------------------------------------------------------------------ Notion
# The booth bookings are mirrored into a Notion database so the operator can work in
# the tool they already use. The sync runs both ways. See docs/notion-booth-setup.md.

# An internal integration token from notion.so/my-integrations, starting "ntn_".
# NOT prefixed NEXT_PUBLIC_ and it must never be: whoever holds this can read and
# rewrite every booking, including customer names and phone numbers.
NOTION_TOKEN=

# The data source id of the booth database, NOT the database id. Recent Notion API
# versions address a database's rows through a data source, and a database can have
# more than one. docs/notion-booth-setup.md says exactly where to find it.
NOTION_BOOTH_DATA_SOURCE_ID=

# Notion sends this once, as a plain token in the body of the first request to the
# webhook URL, when the subscription is created. The endpoint logs it; paste it back
# into Notion to verify, and set it here. Every later request is signed with it, and
# an unsigned or wrongly signed request is refused.
NOTION_WEBHOOK_SECRET=

# --------------------------------------------------------------------- Scheduled
# A long random string of your own making. Guards the reconcile endpoint, which is
# called by a Vercel cron and by a GitHub Actions schedule. Without it that endpoint is
# a way for anyone to make the site hammer Notion.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
