node_modules
.next
out
# Anchored to the repository root deliberately. A bare `build` matches a directory of
# that name at any depth, and this project has one: src/app/(site)/build is the customer
# facing builder route. That single unanchored word kept the entire flow, the form, the
# theme picker, the preview, the payment screen and the status screen, out of every
# commit this repository has ever had.
/build
.DS_Store
*.pem

.env
.env*.local

.vercel
next-env.d.ts
*.tsbuildinfo

backups/

# Temporary probe scripts. Never meant to be kept.
/probe*.cjs
/*.probe.ts

# Third party agent skills, installed per developer rather than committed.
# They live in the user profile now (npx skills add Leonxlnx/taste-skill --global),
# so a copy here would be duplicate weight in a repo that ships an invitation app.
/.agents
/.claude/skills
/skills-lock.json

# Firebase CLI debug output
firebase-debug.log
firestore-debug.log
*-debug.log

# Service account keys. Never in the repo, and never under public/, which is served
# to the internet — a key there is one deploy away from being world readable.
secrets/
*service-account*.json
*firebase-adminsdk*.json

# graphify knowledge graph. graph.json and GRAPH_REPORT.md are shared so everyone
# works from the same map, and .gitattributes registers a merge driver for graph.json
# so two people rebuilding it does not become a conflict. Everything else is derived
# or machine local: graph.html regenerates from graph.json, and .graphify_python holds
# an absolute path to one developer's interpreter.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
