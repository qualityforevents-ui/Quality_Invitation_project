// qlty.events digital invitations
//
// Connection URLs live in prisma.config.ts, not here, because Prisma 7 removed the
// datasource url property from schema files. The split the spec asks for is preserved:
//
//   runtime  -> DATABASE_URL, the Supavisor transaction pooler on port 6543, reached
//               through the pg driver adapter in src/lib/db.ts
//   migrate  -> DIRECT_URL, the direct connection on port 5432, set as datasource.url
//               in prisma.config.ts where only the CLI reads it
//
// See SETUP.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Invitation {
  id        String @id @default(cuid())
  editToken String @unique // 32+ char cryptographically random
  slug      String @unique // public URL, e.g. "moaaz-reem"
  requestId String @unique // short human readable, e.g. "QLT-7K4M9P"
  status    Status @default(DRAFT)

  // language
  uiLang         Lang @default(AR) // builder UI + WhatsApp message
  invitationLang Lang @default(AR) // what guests see

  // event data
  eventType     EventType @default(ENGAGEMENT)
  name1         String // groom
  name2         String // bride
  eventDate     DateTime
  eventTime     String // "20:00"
  venueName     String
  venueMapUrl   String?
  customMessage String?

  // presentation
  themeId       String
  musicTrackId  String
  photoFileId   String? // ImageKit file id, null if no photo
  photoCrop     Json? // { x, y, width, height } applied via ImageKit URL params
  ogImageUrl    String? // generated once at activation, stored

  // ops
  customerPhone String?
  paymentNote   String? // operator pastes InstaPay reference here
  rejectReason  String?
  viewCount     Int       @default(0)
  activatedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
}

enum Status {
  DRAFT // built, never reached payment
  AWAITING_CONFIRMATION // tapped the WhatsApp button, not yet activated
  ACTIVE // link is live
  EXPIRED
  REJECTED
}

enum Lang {
  AR
  EN
}

enum EventType {
  ENGAGEMENT
  WEDDING
  KATB_KETAB
}

// Written to daily by the Vercel cron so the free Supabase project never idles
// into a pause after 7 days of no activity. A single row, upserted in place.
model Heartbeat {
  id     Int      @id @default(1)
  beatAt DateTime @updatedAt
  count  Int      @default(0)
}
