rules_version = '2';

// Nothing reaches Firestore from a browser. Every read and write in this app goes
// through the Admin SDK on the server, which bypasses these rules entirely, so the
// correct rule for direct client access is none at all. Anything that starts talking
// to Firestore from the client is a bug, and this makes it fail loudly rather than
// quietly reading customers' phone numbers.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
